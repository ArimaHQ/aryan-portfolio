{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aryan-portfolio",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-07-19",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCESS_REQUESTS_DO",
        "class_name": "AccessRequestsStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "access-requests-v1",
      "new_sqlite_classes": [
        "AccessRequestsStore"
      ]
    }
  ]
}
